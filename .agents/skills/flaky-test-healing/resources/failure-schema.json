{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FailureTraceSchema",
  "type": "object",
  "required": ["specFile", "testTitle", "errorName", "errorMessage", "failedLine"],
  "properties": {
    "specFile": { "type": "string" },
    "testTitle": { "type": "string" },
    "errorName": { "type": "string" },
    "errorMessage": { "type": "string" },
    "failedLine": { "type": "integer" },
    "traceZipPath": { "type": "string" },
    "screenshotPath": { "type": "string" },
    "failingLocator": { "type": "string" },
    "diagnosedCause": {
      "type": "string",
      "enum": ["Selector Drift", "Hydration Race", "Application Defect", "Environmental Timeout"]
    }
  }
}
